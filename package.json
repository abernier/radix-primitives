{
  "name": "radix-primitives",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.30.0",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-themes": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chromatic": "^16.0.0",
    "eslint": "^10.1.0",
    "eslint-plugin-workspaces": "^0.12.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.3.3",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.2.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "lint": "eslint .",
    "lgtm": "pnpm run build && pnpm run lint && pnpm run check-format && pnpm run check-exports && pnpm run typecheck && pnpm run test",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "test": "pnpm --filter \"./packages/*\" run test",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "check-exports": "pnpm --filter \"./packages/*\" run check-exports",
    "release": "pnpm run build && changeset publish",
    "local-release": "pnpm run lgtm && changeset version && changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token $CHROMATIC_PROJECT_TOKEN",
    "prepare": "husky",
    "changeset": "pnpm exec changeset"
  }
}
